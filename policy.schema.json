{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/procurement-harness/policy.schema.json",
  "title": "Procurement Harness Policy",
  "type": "object",
  "required": [
    "run_id",
    "purchase_goal",
    "max_budget_usd",
    "allowed_merchants",
    "prohibited_categories",
    "required_receipt_fields",
    "human_approval_required"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 8
    },
    "purchase_goal": {
      "type": "string",
      "minLength": 10
    },
    "max_budget_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "allowed_merchants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "prohibited_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "required_receipt_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "merchant",
          "item",
          "price",
          "timestamp",
          "last4",
          "authorization_status"
        ]
      }
    },
    "human_approval_required": {
      "type": "boolean"
    }
  }
}
